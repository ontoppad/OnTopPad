[Unit]
Description=ONTOPPAD API, indexer and payout keeper (%i)
After=network-online.target
Wants=network-online.target

[Service]
User=ontop
Group=ontop
WorkingDirectory=/srv/ontoppad/%i
EnvironmentFile=/srv/ontoppad/%i/api.env
ExecStart=/usr/bin/node /srv/ontoppad/%i/api/server.mjs
Restart=always
RestartSec=3
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/srv/ontoppad/%i/data
MemoryMax=512M

[Install]
WantedBy=multi-user.target
