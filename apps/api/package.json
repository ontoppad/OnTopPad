{
  "name": "@ontoppad/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --experimental-strip-types --watch src/server.ts",
    "build": "esbuild src/server.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist/server.mjs --banner:js=\"import{createRequire}from'node:module';const require=createRequire(import.meta.url);\"",
    "start": "node dist/server.mjs",
    "typecheck": "tsc -p .",
    "test": "node --test --experimental-strip-types src/*.test.ts"
  },
  "dependencies": {
    "@hono/node-server": "2.1.6",
    "@ontoppad/shared": "workspace:*",
    "hono": "4.13.17",
    "viem": "2.57.17"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  }
}
