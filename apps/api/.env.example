NETWORK=testnet
PORT=8787
# bind address; production binds the docker0 bridge so only the Traefik proxy can reach it
HOST=127.0.0.1
# built web app to serve alongside the API (production only)
WEB_DIR=
DATA_DIR=./data
PUBLIC_URL=https://testnet.ontoppad.com
# optional: private RPC; defaults to the public Robinhood RPC
RPC_URL=
# keeper (collects fees, pushes holder payouts). Leave empty to run read-only.
PRIVATE_KEY=
KEEPER_INTERVAL_SEC=900
# $1 on mainnet; testnet balances are worth fractions of a cent, so use 0.0001 there
MIN_HOLD_USD=1
